# ---------------------------------------------------------------------------
# Cadence — environment variables
# Copy to `.env.local` for local development. These are already set in Vercel.
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — NEVER import these in a client component / browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPERADMIN_EMAIL=

# Phase 4 — documents (server-only)
DOCUMENT_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@cadencemail.s1mplesolutions.cc

# Asana OAuth (server-only except redirect URI is also registered in Asana console)
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
ASANA_REDIRECT_URI=https://cadence-eta-five.vercel.app/api/asana/callback
# Google Calendar OAuth (server-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://cadence-eta-five.vercel.app/api/google-calendar/callback

# Vercel Cron — webhook retry processor (server-only)
CRON_SECRET=
